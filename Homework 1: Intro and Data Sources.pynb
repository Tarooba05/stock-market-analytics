    {
      "cell_type": "code",
      "source": [
        "# normally 252 trading days\n",
        "dax_daily['adj_close_last_year'] = dax_daily['Close'].shift(252)\n",
        "dax_daily['yoy_growth'] = dax_daily['Close'] / dax_daily['adj_close_last_year'] -1"
      ],
